{
  "name": "healbytes-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n frontend,backend,ai-engine -c blue,green,magenta \"npm:dev:frontend\" \"npm:dev:backend\" \"npm:dev:ai-engine\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && ./venv/bin/python manage.py runserver 0.0.0.0:8000",
    "dev:ai-engine": "cd ai-engine && ./.venv/bin/python -m uvicorn app.main:app --reload --port 8001",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
