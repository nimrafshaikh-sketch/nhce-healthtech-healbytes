DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

REDIS_URL=redis://localhost:6379/0

POSTGRES_DB=healbytes
POSTGRES_USER=healbytes
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# AI engine integration - no contract agreed yet, leave blank to disable
AI_ENGINE_URL=
AI_ENGINE_TIMEOUT_SECONDS=8

INVITATION_CODE_EXPIRY_MINUTES=15
QR_TOKEN_EXPIRY_MINUTES=15

# Caretaker email - console backend prints emails to the log instead of
# sending them. Switch EMAIL_BACKEND + fill these in for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@healbytes.local
