# ==========================================
# Frontend Configuration (Vite + React)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK_DATA=false

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_DB=healbytes
POSTGRES_USER=healbytes
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healbytes:change-me@localhost:5432/healbytes

# ==========================================
# Django Backend Configuration
# ==========================================
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=django-insecure-healbytes-secret-key-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

REDIS_URL=redis://redis:6379/0

# AI engine integration
AI_ENGINE_URL=
AI_ENGINE_TIMEOUT_SECONDS=8

INVITATION_CODE_EXPIRY_MINUTES=15
QR_TOKEN_EXPIRY_MINUTES=15

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@healbytes.local
