# HealBytes — PostgreSQL environment variables

# Docker PostgreSQL is available on localhost:5433
DATABASE_URL=postgresql://healbytes_app:REPLACE_WITH_REAL_PASSWORD@localhost:5433/healbytes

PGHOST=localhost
PGPORT=5433
PGDATABASE=healbytes
PGUSER=healbytes_app
PGPASSWORD=REPLACE_WITH_REAL_PASSWORD

# Docker PostgreSQL
POSTGRES_DB=healbytes
POSTGRES_USER=healbytes_app
POSTGRES_PASSWORD=REPLACE_WITH_REAL_PASSWORD
