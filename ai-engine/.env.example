AI_MODEL_VERSION=0.0.0-unimplemented
AI_LOG_LEVEL=INFO

# --- Agent foundation (Gemini reasoning layer) ---
# Required for any /agents/* endpoint. Never commit a real key.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the default model alias with a pinned version string.
GEMINI_MODEL=gemini-3.6-flash
# Optional: max Gemini <-> tool round-trips per request before giving up.
AGENT_MAX_TOOL_ITERATIONS=4

# --- Existing Django backend (tools call it over HTTP; never a direct DB
# connection, and the AI Engine never mints its own auth - it forwards the
# caller's bearer token) ---
BACKEND_API_BASE_URL=http://localhost:8000
BACKEND_API_TIMEOUT_SECONDS=8
