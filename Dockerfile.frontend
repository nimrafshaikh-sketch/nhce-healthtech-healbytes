# Multi-stage production build for HealBytes Frontend + Nginx TLS Reverse Proxy
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html postcss.config.js tailwind.config.js vite.config.js ./
COPY src ./src

ARG VITE_API_BASE_URL=/api
ARG VITE_AI_ENGINE_URL=/ai
ARG VITE_USE_MOCK_DATA=false

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_AI_ENGINE_URL=${VITE_AI_ENGINE_URL}
ENV VITE_USE_MOCK_DATA=${VITE_USE_MOCK_DATA}

RUN npm run build

FROM nginx:1.27-alpine AS runtime

RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx/healbytes.conf /etc/nginx/conf.d/healbytes.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1

